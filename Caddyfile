# Локальная разводка (docker compose на ноутбуке, http://localhost:8080). На сервере вместо него
# работает общий Caddy с HTTPS: deploy/edge (см. docs/DEPLOY.md).
:80 {
	handle /api/* {
		reverse_proxy api:8000
	}
	handle /health {
		reverse_proxy api:8000
	}
	handle /admin* {
		# админка владельца (B09) — HTML отдаёт сам api, за basic auth
		reverse_proxy api:8000
	}
	handle {
		reverse_proxy web:3000
	}
}
