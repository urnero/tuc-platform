# Скопировать в deploy/edge/.env (bootstrap.sh делает это сам). В репозиторий не попадает.
ACME_EMAIL=                 # почта для Let's Encrypt: предупреждения об истечении сертификата
PROD_DOMAIN=                # боевой домен, например tuc3d.ru (ветка main, стенд /srv/tuc/prod)
STAGING_DOMAIN=             # тестовый домен, например staging.tuc3d.ru (ветка dev); пусто = стенда нет
