# Скопируй в .env и заполни. Файл .env в репозиторий не попадает.
# Комментарий после пустого значения писать нельзя (`KEY=   # …`): docker compose примет его за значение.
# Поэтому у пустых переменных пояснение стоит строкой выше.

# --- общее ---
APP_ENV=dev                     # dev | staging | prod
# Внешний адрес сайта (без слэша в конце). Его же web кладёт в canonical-ссылки, sitemap.xml и robots.txt.
SITE_URL=http://localhost:8080
DATA_DIR=./data                 # куда складывать загруженные модели и результаты

# --- загрузка моделей (B02) ---
MAX_UPLOAD_MB=100               # максимальный размер файла модели
# Защита от цикла запросов с одного IP (api/app/limits.py): сколько раз в минуту можно создавать
# загрузки (файл, «Заказать» из каталога и редактора, тиснение) и заказы; при превышении — 429. 0 = без ограничений.
RATE_LIMIT_UPLOADS_PER_MIN=10
RATE_LIMIT_ORDERS_PER_MIN=5
MIN_FREE_DISK_GB=2              # свободно на диске с DATA_DIR меньше этого — загрузки отвечают 503. 0 = не проверять
QUOTE_TTL_HOURS=24              # сколько часов действует расчёт цены; старше — заказ не оформить, нужно пересчитать. 0 = без срока
PRINT_BED_MM=256x256x256        # рабочая область самого большого принтера X×Y×Z, мм (Bambu P1S; для предупреждения «не влезает»)
# префикс номера заказа: BP-12 (старые заказы в таблице учёта остались с ТУЦ-)
ORDER_NUMBER_PREFIX=BP

# --- слайсинг (B04) ---
PROFILES_DIR=profiles           # ini-профили PrusaSlicer (printer.ini, print.ini, filament/*.ini)
PRUSA_SLICER_BIN=prusa-slicer   # команда слайсера; в контейнере worker задана сама
SLICE_TIMEOUT_S=600             # сколько секунд ждём слайсер на одну модель

# --- цены (B05) ---
PRICING_PATH=config/pricing.yaml  # прайс; после правки файла перезапустить api
COLORS_PATH=config/colors.yaml    # цвета пластика для раскраски по частям (B31); после правки перезапустить api
MATERIALS_PATH=config/materials.yaml  # справочник материалов (B44): описания, цвета, смолы «по запросу»; перечитывается сам

# --- каталог готовых моделей (B20) ---
CATALOG_DIR=catalog             # catalog.yaml + models/*.stl; перечитывается сам, перезапуск не нужен

# --- параметрические редакторы (B21) ---
EDITORS_DIR=editors             # editors/<slug>/editor.yaml + model.scad; перечитывается сам
OPENSCAD_BIN=openscad           # команда OpenSCAD; стоит только в контейнере worker (worker/Dockerfile)
OPENSCAD_TIMEOUT_S=120          # сколько секунд ждём OpenSCAD на одну модель

# --- база и очередь ---
POSTGRES_USER=tuc
POSTGRES_PASSWORD=change_me
POSTGRES_DB=tuc
DATABASE_URL=postgresql+psycopg://tuc:change_me@postgres:5432/tuc  # заказы (B06); для локального прогона без Postgres: sqlite:///./data/dev.db
REDIS_URL=redis://redis:6379/0  # пусто = без очереди, API слайсит сам (только для разработки)

# --- Telegram (B07) ---
# TELEGRAM_BOT_TOKEN — токен от @BotFather; пусто = уведомлений нет, сервис bot не стартует.
#   Тот же бот шлёт статусы клиентам (B34): клиент подключает его кнопкой на странице заказа.
# TELEGRAM_OWNER_CHAT_ID — ваш chat_id (число, узнать у @userinfobot); бот слушает только его.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# --- ЮKassa (B08) ---
# YOOKASSA_SHOP_ID — shopId из кабинета ЮKassa; пусто = кнопки «Оплатить» на сайте нет.
# YOOKASSA_SECRET_KEY — секретный ключ (тестовый магазин — test_…, боевой — live_…).
# YOOKASSA_VAT_CODE — ставка НДС для чека 54-ФЗ: 1 — без НДС, 2 — 0%, 3 — 10%, 4 — 20%; пусто = чек не вкладываем (самозанятый).
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_VAT_CODE=
# Адрес для HTTP-уведомлений в кабинете ЮKassa: <SITE_URL>/api/v1/payments/yookassa/webhook

# --- Google-таблица учёта (B11) ---
# GOOGLE_SA_JSON_PATH — JSON-ключ сервисного аккаунта (на сервере: /srv/tuc/prod/secrets/google-sa.json,
#   в контейнер он попадает как /srv/secrets/google-sa.json — см. docker-compose). Пусто = экспорт выключен.
# GOOGLE_SHEET_ID — id таблицы из адреса docs.google.com/spreadsheets/d/<ID>/edit; таблица расшарена
#   редактору на e-mail сервисного аккаунта. Worker переписывает лист GOOGLE_SHEET_TAB каждую ночь (05:05 МСК);
#   руками: docker compose exec api python -m app.sheets
GOOGLE_SA_JSON_PATH=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Заказы (сайт)
# GOOGLE_SHEET_LIVE — строка заказа появляется/обновляется в листе сразу (B47); false — только ночью
GOOGLE_SHEET_LIVE=true

# --- Google Drive: файлы заказов (B46) ---
# Каждый заказ → папка «Заказы сайта/ГГГГ-ММ/BP-N — Имя» (исходник, обработанная модель, заказ.txt).
# Обычный Gmail: client_id/secret OAuth-клиента типа «Desktop app» и refresh-токен
#   (получить на ноутбуке: cd api && python -m app.drive auth). FOLDER_ID оставить пустым.
# Google Workspace: вместо трёх строк ниже — GOOGLE_SA_JSON_PATH и папка общего диска в FOLDER_ID.
# Всё пусто = копирование выключено. Подробно — docs/DEPLOY.md, раздел «Google Drive».
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
# id папки из адреса drive.google.com/drive/folders/<ID> (только для сервисного аккаунта)
GOOGLE_DRIVE_FOLDER_ID=
# корневая папка в «Моём диске» (OAuth); создаётся сама
GOOGLE_DRIVE_ROOT_NAME=Заказы сайта

# --- автоудаление файлов моделей (B15) ---
# Сроки обещаны в политике ПДн (/policy, раздел 6). Worker чистит каждую ночь в 04:35 МСК;
# руками: docker compose exec api python -m app.cleanup (посмотреть без удаления: --dry-run). 0 = не удалять.
CLEANUP_UPLOADS_DAYS=30         # загрузки, по которым заказ не оформлен
CLEANUP_ORDER_FILES_DAYS=365    # файлы заказов со статусом «выдан» или «отменён» (считая от закрытия заказа)

# --- обезличивание заказов (B35) ---
# Через 5 лет после закрытия заказа (срок хранения документов об оплате) worker стирает в нём данные
# клиента: имя, телефон, e-mail, адрес, комментарий, реквизиты организации, Telegram. Суммы, материал
# и снимок расчёта остаются для аналитики. Ночью в 04:50 МСК; руками: docker compose exec api
# python -m app.anonymize (посмотреть без изменений: --dry-run). 0 = не обезличивать.
ANONYMIZE_ORDERS_DAYS=1826

# --- админка (B09) ---
# <SITE_URL>/admin — список заказов, карточка, смена статуса, файлы, CSV. Вход — basic auth браузера.
# ADMIN_PASSWORD — пусто = админка выключена; поставьте длинный пароль (на сервере его создаёт deploy/bootstrap.sh).
ADMIN_USER=admin
ADMIN_PASSWORD=

# --- письма и кабинет клиента (B32) ---
# Кабинет (<SITE_URL>/account): клиент вводит e-mail, получает письмом 6-значный код, видит историю заказов
# и может повторить заказ. Письма уходят через SMTP любой почты (Яндекс 360, Mail.ru, Timeweb…).
# Через тот же SMTP клиенту приходят письма о заказе (B34): «принят», «оплачен», «печатается», «готов».
# SMTP_HOST — адрес SMTP-сервера (smtp.yandex.ru, smtp.mail.ru…); пусто = вход в кабинет отвечает 503;
#   значение `log` — письмо не отправляется, а пишется в лог api (проверка на ноутбуке: docker compose logs api).
# SMTP_USER / SMTP_PASSWORD — почтовый ящик и пароль приложения (не пароль от аккаунта: его выдают в настройках почты).
# SMTP_FROM — от кого письмо (`ТУЦ <noreply@домен>`); пусто = SMTP_USER. SMTP_SSL=true — порт 465, false — 587 (STARTTLS).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SSL=true
# OWNER_EMAIL — ваша почта: сюда придут заявки «цена по запросу» (смолы), если есть SMTP_HOST.
# Пусто = только Telegram и /admin/leads. Без бота и без почты клиент видит «ответим в рабочее время» и ваши контакты.
OWNER_EMAIL=
LOGIN_CODE_TTL_MIN=15           # сколько минут действует код из письма
SESSION_DAYS=30                 # сколько дней клиент остаётся в кабинете без повторного входа
RATE_LIMIT_LOGIN_PER_MIN=5      # запросов кода и попыток ввода в минуту с одного IP; 0 = без ограничений
# Номер счётчика Яндекс.Метрики (B51), только цифры; пусто = счётчик выключен
NEXT_PUBLIC_YM_ID=
