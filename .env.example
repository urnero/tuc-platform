# Скопируй в .env и заполни. Файл .env в репозиторий не попадает.

# --- общее ---
APP_ENV=dev                     # dev | staging | prod
SITE_URL=http://localhost:8080  # внешний адрес сайта
DATA_DIR=./data                 # куда складывать загруженные модели и результаты

# --- база и очередь ---
POSTGRES_USER=tuc
POSTGRES_PASSWORD=change_me
POSTGRES_DB=tuc
DATABASE_URL=postgresql+psycopg://tuc:change_me@postgres:5432/tuc
REDIS_URL=redis://redis:6379/0

# --- Telegram (B07) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# --- ЮKassa (B08) ---
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# --- Google Sheets (B11) ---
GOOGLE_SA_JSON_PATH=
GOOGLE_SHEET_ID=

# --- админка (B09) ---
ADMIN_USER=admin
ADMIN_PASSWORD=change_me
